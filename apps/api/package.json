{
  "name": "@balvatika/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:generate": "node src/prisma-cli.js generate --schema ../../prisma/schema.prisma",
    "db:migrate:dev": "node src/prisma-cli.js migrate dev --schema ../../prisma/schema.prisma",
    "db:migrate:deploy": "node src/prisma-cli.js migrate deploy --schema ../../prisma/schema.prisma",
    "db:seed": "node src/seed.js",
    "test": "vitest run --config vitest.config.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.1",
    "argon2": "^0.41.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jose": "^5.9.6",
    "multer": "^2.4.0",
    "sharp": "^0.35.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "prisma": "^6.19.1",
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  }
}

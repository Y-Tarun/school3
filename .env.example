# PostgreSQL connection used by Prisma and the API.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/balvatika?schema=public

# Required only when creating the initial administrator with `npm run db:seed`.
# Set an administrator-controlled email and a unique password of at least 12 characters.
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=

# API configuration. Generate distinct random values with `openssl rand -base64 48`.
# These example values are placeholders only and must not be used in production.
NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=replace-this-with-a-random-64-character-secret-for-local-development
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=use-a-different-random-64-character-secret-for-local-development
JWT_REFRESH_TTL=7d

# Student photographs are stored outside the public web root.
# Relative paths resolve from the API process working directory.
PHOTO_STORAGE_DIR=../../local-data/photos

# Optional WhatsApp Cloud API template notification settings.
# Enquiries are still stored if these values are blank or provider delivery fails.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT_PHONE=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_GRAPH_API_VERSION=v22.0

# Integration tests must target a dedicated disposable database ending in `_test`.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/balvatika_api_test?schema=public
